  "quality_issues": [
    {
      "id": "q1",
      "severity": "medium",
      "title": "Scope 3 total does not match its line items",
      "detail": "Report states 22,438.78 tCO2e; the eight listed items sum to 22,556.20 (difference about 117.4)."
    },
    {
      "id": "q2",
      "severity": "high",
      "title": "Electricity kWh do not reconcile with emissions at the stated factor",
      "detail": "At 0.495 kg/kWh: 45,298,962 kWh gives about 22,423 t (stated 25,021.71); 176,806 kWh gives about 87.5 t (stated 60.69); 5,320,000 kWh gives about 2,633 t (stated 1,878.79)."
    },
    {
      "id": "q3",
      "severity": "medium",
      "title": "Grid emission factor has no named source",
      "detail": "0.495 kg/kWh is used without citation; the CEA all-India factor is higher (about 0.675 to 0.710)."
    },
    {
      "id": "q4",
      "severity": "low",
      "title": "Reporting year ambiguity",
      "detail": "Report is titled 2025 but electricity data is for calendar year 2024."
    },
    {
      "id": "q5",
      "severity": "medium",
      "title": "Scope 3 dominated by one survey-extrapolated line",
      "detail": "Outside IIT visits are about 90% of Scope 3 and rely on a department survey scaled to 33 entities."
    },
    {
      "id": "q6",
      "severity": "low",
      "title": "LPG factors use different bases",
      "detail": "Canteens use 2.89 kgCO2e/kg while catering uses 1.473 kgCO2/L; units are not reconciled."
    }
  ],
